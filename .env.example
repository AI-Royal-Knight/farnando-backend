# Copy to .env for local development. Production uses real environment
# variables or a secrets manager; never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-development-secret-change-me
DJANGO_DEBUG=True
DJANGO_ENVIRONMENT=local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://postgres:postgres@localhost:5432/adelgaceya
DB_CONNECT_TIMEOUT=5
DB_CONN_MAX_AGE=60
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
SITE_NAME=Adelgaceya
ENABLE_API_DOCS=True
# Local/compose only: docs open without login even with DEBUG off.
API_DOCS_PUBLIC=True

# Google OAuth (optional locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: console locally; use an Anymail backend in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SMTP backend only (docker compose points these at Mailpit).
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Adelgaceya <no-reply@adelgaceya.pe>
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=

# Media: leave bucket empty for local filesystem storage, or point to MinIO.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_EXPIRE=300

# Consents (LEGAL_REVIEW: replace with the approved document versions)
CONSENT_TERMS_VERSION=2026-11-01
CONSENT_PRIVACY_VERSION=2026-11-01
CONSENT_HEALTH_DATA_VERSION=2026-11-01
COMPLAINT_RESPONSE_SLA_HOURS=24
SUPPORT_NOTIFICATION_EMAILS=

# 32-byte urlsafe base64 Fernet key(s), comma-separated. First key encrypts.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER use this example value outside tests.
FIELD_ENCRYPTION_KEYS=tW8uBgbY93Ih64CaqRsEIDheNMVimjTE97KQKAyVAxA=

# CORS / CSRF (explicit allow-lists only)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# Throttling
THROTTLE_ANON=100/day
THROTTLE_USER=1000/day
THROTTLE_AUTH=5/min
THROTTLE_PASSWORD_RESET=3/hour
THROTTLE_PASSWORD_RESET_EMAIL=3/hour
THROTTLE_EMAIL_VERIFICATION=3/hour
THROTTLE_CONTACT=5/hour
THROTTLE_CONTACT_EMAIL=3/hour
THROTTLE_COMPLAINT=5/hour
THROTTLE_COMPLAINT_STATUS=10/hour
THROTTLE_ASSESSMENT_CREATE=20/hour
THROTTLE_ASSESSMENT_MEASUREMENTS=120/min
THROTTLE_ASSESSMENT_SUBMIT=5/hour
THROTTLE_ASSESSMENT_PAYMENT=5/hour
THROTTLE_LAB_UPLOAD=20/hour
THROTTLE_UPLOAD=20/hour
THROTTLE_MESSAGING=60/min

# Part 2: lab upload limits and integration ports. The fake provider and no-op
# scanner are for local/tests only; production must configure real adapters.
LAB_UPLOAD_MAX_BYTES=10485760
LAB_UPLOAD_URL_TTL_SECONDS=900
LAB_DOWNLOAD_URL_TTL_SECONDS=300
PAYMENT_PROVIDER=apps.assessments.payments.FakePaymentProvider
# Local only: settle fake charges at once (no webhook). Production refuses to start with it on.
PAYMENTS_AUTO_CONFIRM=True
LAB_SCANNER=apps.assessments.scanning.NoopLabScanner

# Part 3: patient portal. [OPEN] values are configuration, not constants.
PORTAL_DEFAULT_TIMEZONE=America/Lima
ADDRESS_MAX_PER_PATIENT=10
CONSULTATION_MIN_BOOKING_LEAD_HOURS=12
CONSULTATION_RESCHEDULE_MIN_HOURS=24
CONSULTATION_CANCEL_MIN_HOURS=2
CONSULTATION_JOIN_EARLY_MINUTES=10
CONSULTATION_JOIN_GRACE_MINUTES=15
CONSULTATION_REQUEST_EXPIRY_HOURS=2
CONSULTATION_REMINDER_HOURS=24,1
VIDEO_PROVIDER=apps.consultations.video.FakeVideoProvider
VIDEO_RECORDING_ENABLED=False
DAILY_API_KEY=
DAILY_DOMAIN=adelgaceya.daily.co
# Webhooks reject every request until these secrets are set.
DAILY_WEBHOOK_SECRET=
CULQI_WEBHOOK_SECRET=
WEBHOOK_MAX_BODY_BYTES=262144
ORDER_NUMBER_PREFIX=ADL-ORD-
ORDER_SHIPPING_FEE=0.00
ORDER_TAX_RATE=0
ORDER_DELIVERY_DAYS_MIN=2
ORDER_DELIVERY_DAYS_MAX=5
SUBSCRIPTION_RETRY_DAYS=1,3,7
SUBSCRIPTION_PAUSE_MAX_DAYS=90
PRESCRIPTION_DOWNLOAD_TTL_SECONDS=300
THROTTLE_CONSULTATION_CREATE=10/hour
THROTTLE_ORDER_CREATE=5/hour

# Part 4: clinician side. [OPEN] values are configuration.
MFA_REQUIRED_ROLES=PHYSICIAN,STAFF,ADMIN
MFA_ISSUER=Adelgaceya
MFA_TOKEN_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5
PHYSICIAN_INVITATION_TTL_DAYS=7
AVATAR_MAX_BYTES=5242880
AVATAR_MAX_PIXELS=4000
AVATAR_URL_TTL_SECONDS=3600
EVALUATION_CLAIM_TIMEOUT_HOURS=4
NEWLY_APPROVED_DAYS=14
PHYSICIAN_RESCHEDULE_MIN_HOURS=1
PRESCRIPTION_MAX_START_DAYS=30
PRESCRIPTION_MAX_VALIDITY_MONTHS=12
CONSENT_CLINICIAN_AGREEMENT_VERSION=2026-11-01
THROTTLE_INVITATION_LOOKUP=20/hour
THROTTLE_INVITATION_ACCEPT=5/hour
THROTTLE_AVATAR_UPLOAD=10/hour

# Captcha for public contact/complaint forms. Production requires a real verifier.
CAPTCHA_REQUIRED=False
CAPTCHA_VERIFIER=apps.core.captcha.NoopCaptchaVerifier
CAPTCHA_SECRET_KEY=

# Axes brute-force protection
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# Back office (Part 5)
REFUND_APPROVAL_LIMIT=500.00
REFUND_FEE_ON_NOT_SUITABLE=false
REPORTING_CURRENCY=PEN
STAFF_INVITATION_TTL_DAYS=7
PRIVACY_RESPONSE_DAYS=20
PRIVACY_EXPORT_TTL_DAYS=7
REPORT_EXPORT_URL_TTL_SECONDS=600
ASSET_MAX_BYTES=5242880
ASSET_MAX_PIXELS=4000
THROTTLE_STAFF_INVITATION_RESEND=5/hour
THROTTLE_STAFF_INVITATION_LOOKUP=20/hour
THROTTLE_STAFF_INVITATION_ACCEPT=5/hour
THROTTLE_TICKET_CREATE=10/hour
THROTTLE_PRIVACY_REQUEST=3/day

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Gunicorn (production)
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
GUNICORN_MAX_REQUESTS=1000
FORWARDED_ALLOW_IPS=127.0.0.1

# Docker Compose host ports. `./scripts/compose-up.sh` (make up) tries these
# first and falls back to the next free port, writing it here with "# auto".
# On a server, also set DJANGO_ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS /
# CORS_ALLOWED_ORIGINS / FRONTEND_URL above to the real domain or IP.
WEB_PORT=8000
POSTGRES_PORT=5435
REDIS_PORT=6381
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
